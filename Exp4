Step 1: Create the database and tables
Create a database named CollegeDB with two related tables, Department and Student,
applying PRIMARY KEY, NOT NULL, UNIQUE, CHECK, DEFAULT, and FOREIGN
KEY constraints.

1. Create Database
CREATE DATABASE CollegeDB;
USE CollegeDB;
2. Table with NOT NULL, UNIQUE, PRIMARY KEY, CHECK, DEFAULT constraints
CREATE TABLE Department ( dept_id INT PRIMARY KEY, dept_name
VARCHAR(50) NOT NULL UNIQUE);
3.CREATE TABLE Student ( roll_no INT PRIMARY KEY, name VARCHAR(50)
NOT NULL, age INT CHECK (age >= 17 AND age <= 30), email VARCHAR(50)
UNIQUE, gender VARCHAR(10) DEFAULT 'Not Specified', dept_id INT,
FOREIGN KEY (dept_id) REFERENCES Department(dept_id));

